<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-18">
        <div class="w-full flex justify-end">
        <a href="/logout" class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block">Logout</a>
        </div>
        <h5 class="mb-5">Edit your post.</h5>
        <form action="/update/<%= post._id %>" method="POST">
            <textarea name="content" class="w-1/3 border-zinc-800 rounded-md resize-none bg-transparent border-2"><%= post.content %></textarea>
            <input type="submit" class="px-3 py-2 bg-yellow-500 text-black block rounded-md mt-2 w-40 text-sm" value="Update Post">
        </form>
        
        
        </div>
    </div>
</body>
</html>