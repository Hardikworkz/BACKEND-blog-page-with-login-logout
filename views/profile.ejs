<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-18">
        <div class="w-full flex justify-end">
        <a href="/logout" class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block">Logout</a>
        </div>
        <h3 class="text-3xl mb-5"><span class="font-light">Hello</span> <%= user.name %> </h3>
        <h5 class="mb-5">You can create a new post.</h5>
        <form action="/post" method="post">
            <textarea placeholder="What's on your mind?" class=" w-1/3 border-zinc-800 rounded-md resize-none bg-transparent border-2 " name="content"></textarea>
            <input type="submit" class="px-3 py-2 bg-blue-500 block rounded-md mt-2 w-40 text-sm" value="Create new post">
        </form>
        <div class="posts mt-20">
            <h3 class="text-zinc-400 mb-4">Your Posts.</h3>
            <div class="Post-Container">
               
                <% user.posts.reverse().forEach(function(post) { %>
                    <div class="post w-1/3 p-4 border-2 mb-2 border-zinc-700 bg-zinc-800 rounded-md">
                        <h4 class="text-blue-500 mb-2"><%= user.username %></h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-4 inline-block"><%= post.likes.length %> likes</small>
                        <div class="btns flex gap-4 mt-1">
                            <a href="/like/<%= post._id %>" class="text-blue-500">
                                <%= post.likes.indexOf(user._id) ? "Like" : "Unlike" %>
                            </a>
                            <a href="/edit/<%= post._id %>" class="text-green-400">Edit</a>
                        </div>
                    </div>
                <% }); %>
              
            </div>
        </div>
        </div>
    </div>
</body>
</html>