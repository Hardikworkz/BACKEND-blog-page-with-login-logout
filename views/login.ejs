<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white flex items-center justify-center">
        <div class="bg-zinc-800 p-8 rounded-md shadow-md w-96">
            <h3 class="text-3xl mb-5 text-center">Login your Account</h3>
            <form action="/login" method="POST">
             
                <input class="px-3 py-2 mb-4 outline-none bg-transparent border-2 border-zinc-500 rounded-md w-full" type="email" placeholder="Email" name="email" required>
                <input class="px-3 py-2 mb-4 outline-none bg-transparent border-2 border-zinc-500 rounded-md w-full" type="password" placeholder="Password" name="password" required>
                <input class="px-5 rounded-md py-2 bg-blue-500 hover:bg-blue-600 transition duration-200 cursor-pointer w-full" type="submit" value="Login Account">
                </form>
        </div>
    </div>
</body>
</html>